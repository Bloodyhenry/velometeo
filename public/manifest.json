{
  "manifest_version": 3,
  "name": "VeloMétéo - Météo & Vent pour cyclistes",
  "version": "1.1.0",
  "description": "Prévisions météo heure par heure et calcul du vent relatif le long de vos parcours vélo (fichiers GPX et compatible Komoot).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Ouvrir VeloMétéo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.komoot.com/*",
    "*://*.komoot.de/*",
    "*://*.komoot.fr/*",
    "*://*.komoot.it/*",
    "*://*.komoot.es/*",
    "*://*.komoot.nl/*",
    "https://api.open-meteo.com/*",
    "https://*.tile.openstreetmap.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.komoot.com/*",
        "*://*.komoot.de/*",
        "*://*.komoot.fr/*",
        "*://*.komoot.it/*",
        "*://*.komoot.es/*",
        "*://*.komoot.nl/*"
      ],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
