{
  "manifest_version": 3,
  "default_locale": "fr",
  "name": "__MSG_appName__",
  "version": "1.1.0",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "velometeo@bloodyhenry.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "sidebar_action": {
    "default_panel": "index.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.komoot.com/*",
    "*://*.komoot.de/*",
    "*://*.komoot.fr/*",
    "*://*.komoot.it/*",
    "*://*.komoot.es/*",
    "*://*.komoot.nl/*",
    "*://*.strava.com/*",
    "https://api.open-meteo.com/*",
    "https://*.tile.openstreetmap.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.komoot.com/*",
        "*://*.komoot.de/*",
        "*://*.komoot.fr/*",
        "*://*.komoot.it/*",
        "*://*.komoot.es/*",
        "*://*.komoot.nl/*",
        "*://*.strava.com/*"
      ],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
